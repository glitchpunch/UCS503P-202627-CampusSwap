{
  "name": "campusswap-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "CampusSwap pages: builds one Tailwind CSS file per page and copies fonts so the site works offline.",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch:login": "tailwindcss -c tailwind/login.config.cjs -i src/tailwind.css -o public/assets/login.css --watch",
    "watch:dashboard": "tailwindcss -c tailwind/dashboard.config.cjs -i src/tailwind.css -o public/assets/dashboard.css --watch",
    "watch:rooms": "tailwindcss -c tailwind/rooms.config.cjs -i src/tailwind.css -o public/assets/rooms.css --watch",
    "watch:admin": "tailwindcss -c tailwind/admin.config.cjs -i src/tailwind.css -o public/assets/admin.css --watch"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "material-symbols": "0.47.2",
    "tailwindcss": "3.4.19"
  }
}
